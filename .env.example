# Daily Standup Bot - Environment Variables
# Copy this file to .env and fill in your actual values
# Or set these in your shell profile (e.g., ~/.zshrc or ~/.bashrc)

# Required: Your Google Gemini API Key
# Get one free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Required: Your Zoho Cliq Incoming Webhook URL
# Get this from your Zoho Cliq channel settings
ZOHO_WEBHOOK_URL=https://cliq.zoho.com/api/v2/channels/{channel_id}/incomingwebhooks/{webhook_token}

# Repo paths: cp config/examples/repos.example.txt repos.txt (one path per line; repos.txt is gitignored)
# REPO_PATHS_FILE=repos.txt

# Optional: git author filter (--author). Comma-separated for multiple identities
# (e.g. personal email + GitHub noreply used on squash merges):
# GIT_AUTHOR=mezie.cjo@gmail.com,84224449+Chimexx@users.noreply.github.com
GIT_AUTHOR=your.email@company.com

# Optional: GitHub token for pull request links (required for private repos)
# Create at: https://github.com/settings/tokens (repo scope)
# GITHUB_TOKEN=ghp_your_token_here

# Optional: repo folder names that get PR links appended (default: mx-quick-manager-backend)
# PR_LINK_REPOS=mx-quick-manager-backend

# --- Weekly standup (Tuesdays; see docs/WEEKLY-STANDUP.md) ---
# Optional: separate bot webhook for the weekly post (recommended if daily uses a channel URL)
# Get from Zoho Cliq → Bots → Amadioha → Webhook URL (/bots/.../incoming or /message)
ZOHO_WEEKLY_WEBHOOK_URL=https://cliq.zoho.com/api/v2/bots/your-bot/incoming?zapikey=...
# Optional: post weekly update to a channel instead of bot DM (channel unique name)
# ZOHO_WEEKLY_CHANNEL=general

# --- Monthly Cliq DM (optional; see docs/MONTHLY-CLIQ.md) ---
# ZOHO_CLIENT_ID=...
# ZOHO_CLIENT_SECRET=...
# ZOHO_REFRESH_TOKEN=...
